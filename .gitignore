# Ignore everything
/*
!/.gitignore

# Allow documentation
!/README.md
# .env is a placeholder template that users edit in place. Never commit changes to it:
# git pull leaves each user's edited copy alone only while the repository copy is unchanged.
!/.env
# GitHub Pages serves docs/; src/docs/ holds its sources
!/docs/
!/envs/

# Allow core logic directories
!/pipeline_stage1/
!/pipeline_stage2/
!/pipeline_stage3/
!/pipeline_stage4/
!/src/

# Real settings; the tracked .env holds placeholders
.env.epic

# Local work in progress
/temp/

# Data and outputs (contain sample IDs): never commit
/data/
/analysis/
*.csv
*.tsv
*.fam
*.psam
*.sample
*.sas7bdat
*.RData
*.exclude
*.kin0

# Exclude specific sub-directories and files within allowed paths
/src/test/
# src/000_env.sh creates src/logs/
/src/logs/
/pipeline_stage1/.nextflow_work/
/pipeline_stage2/logs/
work/
conda/
.nextflow/
.nextflow.log*

# Global ignores (even in allowed paths)
.DS_Store
._*
__pycache__/
*.pyc
*.zip
*.tar.gz
*.log
*.tmp
